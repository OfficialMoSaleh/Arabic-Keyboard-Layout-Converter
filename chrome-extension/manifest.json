{
  "manifest_version": 3,
  "name": "مُحوّل لغة الكتابة (عربي ⇋ إنجليزي)",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "حل سحري لتحويل النص المكتوب بلغة خاطئة فوراً بضغطة زر مع شريط عائم على المواقع.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "مُحوّل لوحة المفاتيح",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["converter.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "convert-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "تحويل النص المحدد أو الحقل النشط فوراً"
    }
  }
}
